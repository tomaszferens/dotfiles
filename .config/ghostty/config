# ghostty +show-config --default --docs
# ghostty +list-themes

# ── Font ─────────────────────────────────────────────────────────────
# JetBrains Mono Regular at 14 (Ghostty bundles it with a Nerd Font symbols
# fallback, so no font-family). Cell geometry copies WezTerm: cell_width 0.9
# and line_height 1.2. Ghostty 1.3 subpixel-aligns glyphs when the cell is
# narrower than the advance, so the -10% does not clip.
# Knob if strokes look lighter than WezTerm's FreeType output:
#   font-thicken = true  (then font-thicken-strength 0-255, default 255)
font-size                      = 14
adjust-cell-width              = -10%
adjust-cell-height             = 20%
font-feature                   = -calt
font-feature                   = -clig
font-feature                   = -liga
window-inherit-font-size       = true

# ── Theme: Tokyo Night ──────────────────────────────────────────────
theme                          = TokyoNight
background                     = 1a1b26

# ── Cursor ───────────────────────────────────────────────────────────
adjust-cursor-thickness        = 2

# ── Underline ────────────────────────────────────────────────────────
# Font defaults. Ghostty draws undercurls (Neovim spell / diagnostics)
# with the underline thickness, so the old 250% made fat squiggles.

# ── Window / Look and Feel ───────────────────────────────────────────
window-padding-x               = 0
window-padding-y               = 0
macos-titlebar-style           = tabs
macos-titlebar-proxy-icon      = hidden
macos-option-as-alt            = true
window-vsync                   = true
mouse-hide-while-typing        = true
unfocused-split-opacity        = 0.6
maximize                       = true

# ── Tab bar ──────────────────────────────────────────────────────────
window-show-tab-bar            = auto

# ── Other ────────────────────────────────────────────────────────────
clipboard-paste-protection     = true
clipboard-trim-trailing-spaces = true
copy-on-select                 = true
link-url                       = true
# Shift bypasses program mouse capture (tmux `mouse on`, reached via herdr).
# Under mouse reporting Ghostty only matches links while Shift is held, so in
# overmind/tmux it is Shift+Cmd to underline and Shift+Cmd+click to open.
# `never` stops a program from taking Shift back with XTSHIFTESCAPE. WezTerm
# equivalent: bypass_mouse_reporting_modifiers = 'SHIFT'.
mouse-shift-capture            = never
macos-auto-secure-input        = true
macos-secure-input-indication  = true
quit-after-last-window-closed  = false
scrollback-limit               = 4194304
shell-integration              = fish
shell-integration-features     = no-cursor,sudo,title
confirm-close-surface          = true
bold-color                     = bright

# ── Keybindings (ALT+SHIFT = mods, matching WezTerm) ─────────────────
# Splits
keybind                        = alt+shift+v=new_split:right
keybind                        = alt+shift+s=new_split:down

# Split navigation
# alt+shift+j/k are performable: herdr owns them (next/previous space) and
# Ghostty only consumes the chord when a split actually exists in that
# direction. In an unsplit herdr tab the key falls through to herdr.
keybind                        = alt+shift+h=goto_split:left
keybind                        = alt+shift+l=goto_split:right
keybind                        = performable:alt+shift+k=goto_split:top
keybind                        = performable:alt+shift+j=goto_split:bottom

# Tabs
keybind                        = alt+shift+t=new_tab
keybind                        = alt+shift+q=close_surface

# Copy/paste
keybind                        = alt+shift+y=copy_to_clipboard
keybind                        = alt+shift+p=paste_from_clipboard

# Font size
keybind                        = alt+minus=decrease_font_size:1
keybind                        = alt+equal=increase_font_size:1
keybind                        = alt+zero=reset_font_size

# Tab switching (alt+1..9)
keybind                        = alt+one=goto_tab:1
keybind                        = alt+two=goto_tab:2
keybind                        = alt+three=goto_tab:3
keybind                        = alt+four=goto_tab:4
keybind                        = alt+five=goto_tab:5
keybind                        = alt+six=goto_tab:6
keybind                        = alt+seven=goto_tab:7
keybind                        = alt+eight=goto_tab:8
keybind                        = alt+nine=goto_tab:9

# Fullscreen toggle
keybind                        = alt+shift+enter=toggle_fullscreen

# Split resizing
keybind                        = ctrl+alt+comma=resize_split:left,5
keybind                        = ctrl+alt+s=resize_split:down,5
keybind                        = ctrl+alt+t=resize_split:up,5
keybind                        = ctrl+alt+period=resize_split:right,5

# Option-arrow word navigation (macOS)
keybind                        = alt+left=esc:b
keybind                        = alt+right=esc:f

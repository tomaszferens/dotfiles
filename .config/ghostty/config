# ghostty +show-config --default --docs
# ghostty +list-themes

# ── Font ─────────────────────────────────────────────────────────────
# JetBrains Mono Regular at 14 (Ghostty bundles it with a Nerd Font symbols
# fallback, so no font-family). Line height copies WezTerm's 1.2.
#
# No adjust-cell-width. Ghostty 1.3 already rounds the cell to the nearest
# pixel of the glyph advance (1.2 used ceil), and on macOS it now keeps the
# fractional centering offset as a subpixel shift whenever the cell is
# narrower than the advance. At size 14 a -10% cell put the LG ULTRAWIDE
# (1x, 3440x1440) at 7px for an 8.4px advance, so every stem sat 0.7px
# between physical pixels and smeared; the 2x Retina panel hid the same
# shift. See ghostty-org/ghostty discussions 11496 and 11338, issue 4504.
# Any negative percentage flips the rounding at some font size, so leave it
# out rather than tune it. If the Retina panel must be tighter, -6% is the
# largest value that still leaves the LG at 8px, but only at size 14.
#
# Thickening is global; Ghostty has no per-display switch (asked for in
# issue 4504, not implemented as of 1.3.1). It turns on CoreText font
# smoothing; strength scales the stroke dilation, never the opacity.
# Measured 2026-09-18 by replaying Ghostty's exact rasterizer on the
# bundled JetBrains Mono at 14pt ('|' stem width and peak pixel coverage,
# 1x LG ULTRAWIDE vs 2x MacBook). The dilation is proportional in points,
# the strength is quantized into five steps, and the 2x panel caps early:
#   off      1x 1.26pt stem, 64% peak (soft, grey) | 2x 1.26pt
#   0-99     1x 1.42pt 71%                          | 2x 1.42pt
#   100-164  1x 1.49pt 75%                          | 2x 1.49pt
#   165-207  1x 1.56pt 78%                          | 2x 1.56pt
#   208-240  1x 1.64pt 82%                          | 2x 1.56pt (capped)
#   241-255  1x 1.71pt 85%                          | 2x 1.56pt (capped)
# 255 is the only value that narrows the gap between the panels: the LG
# gets its most solid strokes and the MacBook pays exactly what 165 costs
# (roughly JetBrains Mono Medium). 100-240 are identical to a neighbour or
# dominated. The one real alternative is 63 (any of 0-99): lightest touch
# on the MacBook, LG only a step above off.
# Iterate with cmd+shift+, (reload_config rebuilds the font atlas).
font-size                      = 14
adjust-cell-height             = 20%
font-thicken                   = true
font-thicken-strength          = 255
font-feature                   = -calt
font-feature                   = -clig
font-feature                   = -liga
window-inherit-font-size       = true

# ── Theme: Tokyo Night ──────────────────────────────────────────────
theme                          = TokyoNight
background                     = 1a1b26

# ── Cursor ───────────────────────────────────────────────────────────
adjust-cursor-thickness        = 2

# ── Underline ────────────────────────────────────────────────────────
# Font defaults. Ghostty draws undercurls (Neovim spell / diagnostics)
# with the underline thickness, so the old 250% made fat squiggles.

# ── Window / Look and Feel ───────────────────────────────────────────
window-padding-x               = 0
window-padding-y               = 0
macos-titlebar-style           = tabs
macos-titlebar-proxy-icon      = hidden
macos-option-as-alt            = true
window-vsync                   = true
mouse-hide-while-typing        = true
unfocused-split-opacity        = 0.6
maximize                       = true

# ── Tab bar ──────────────────────────────────────────────────────────
window-show-tab-bar            = auto

# ── Other ────────────────────────────────────────────────────────────
clipboard-paste-protection     = true
clipboard-trim-trailing-spaces = true
copy-on-select                 = true
link-url                       = true
# Shift bypasses program mouse capture (tmux `mouse on`, reached via herdr).
# Under mouse reporting Ghostty only matches links while Shift is held, so in
# overmind/tmux it is Shift+Cmd to underline and Shift+Cmd+click to open.
# `never` stops a program from taking Shift back with XTSHIFTESCAPE. WezTerm
# equivalent: bypass_mouse_reporting_modifiers = 'SHIFT'.
mouse-shift-capture            = never
macos-auto-secure-input        = true
macos-secure-input-indication  = true
quit-after-last-window-closed  = false
scrollback-limit               = 4194304
shell-integration              = fish
shell-integration-features     = no-cursor,sudo,title
confirm-close-surface          = true
bold-color                     = bright

# ── Keybindings (ALT+SHIFT = mods, matching WezTerm) ─────────────────
# Splits
keybind                        = alt+shift+v=new_split:right
keybind                        = alt+shift+s=new_split:down

# Split navigation
# alt+shift+j/k are performable: herdr owns them (next/previous space) and
# Ghostty only consumes the chord when a split actually exists in that
# direction. In an unsplit herdr tab the key falls through to herdr.
keybind                        = alt+shift+h=goto_split:left
keybind                        = alt+shift+l=goto_split:right
keybind                        = performable:alt+shift+k=goto_split:top
keybind                        = performable:alt+shift+j=goto_split:bottom

# Tabs
keybind                        = alt+shift+t=new_tab
keybind                        = alt+shift+q=close_surface

# Copy/paste
keybind                        = alt+shift+y=copy_to_clipboard
keybind                        = alt+shift+p=paste_from_clipboard

# Font size
keybind                        = alt+minus=decrease_font_size:1
keybind                        = alt+equal=increase_font_size:1
keybind                        = alt+zero=reset_font_size

# Tab switching (alt+1..9)
keybind                        = alt+one=goto_tab:1
keybind                        = alt+two=goto_tab:2
keybind                        = alt+three=goto_tab:3
keybind                        = alt+four=goto_tab:4
keybind                        = alt+five=goto_tab:5
keybind                        = alt+six=goto_tab:6
keybind                        = alt+seven=goto_tab:7
keybind                        = alt+eight=goto_tab:8
keybind                        = alt+nine=goto_tab:9

# Fullscreen toggle
keybind                        = alt+shift+enter=toggle_fullscreen

# Split resizing
keybind                        = ctrl+alt+comma=resize_split:left,5
keybind                        = ctrl+alt+s=resize_split:down,5
keybind                        = ctrl+alt+t=resize_split:up,5
keybind                        = ctrl+alt+period=resize_split:right,5

# Option-arrow word navigation (macOS)
keybind                        = alt+left=esc:b
keybind                        = alt+right=esc:f
